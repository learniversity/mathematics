      "expression": "(a + b) × c = a × c + b × c",
      "description": "Distributive property."
    }
  ],
  "examples": [
    {
      "question": "Calculate 47 × 6.",
      "steps": [
        "40 × 6 = 240.",
        "7 × 6 = 42.",
        "240 + 42 = 282."
      ],
      "answer": "282"
    },
    {
      "question": "Calculate 238 × 4.",
      "steps": [
        "200 × 4 = 800; 30 × 4 = 120; 8 × 4 = 32.",
        "800 + 120 + 32 = 952."
      ],
      "answer": "952"
    }
  ],
