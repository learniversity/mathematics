  "formulas": [
    {
      "expression": "10,000 = 10 × 1,000",
      "description": "Ten thousands form one ten-thousand."
    }
  ],
  "examples": [
    {
      "question": "Read 4,306.",
      "steps": [
        "4 thousands = 4,000; 3 hundreds = 300; 0 tens; 6 ones."
      ],
      "answer": "four thousand three hundred and six"
    },
    {
      "question": "What follows 9,999?",
      "steps": [
        "Add one to reach the next ten-thousand."
      ],
      "answer": "10000"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "Write seven thousand and fifty in digits.",
      "answer": 7050,
      "solution": "7,000 + 50 = 7,050."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "Write 8000 + 300 + 2 as a number.",
      "answer": 8302,
      "solution": "8,000 + 300 + 0 + 2 = 8,302."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "What comes before 6,000?",
      "answer": 5999,
      "solution": "6,000 − 1 = 5,999."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "What comes after 8,999?",
      "answer": 9000,
      "solution": "8,999 + 1 = 9,000."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "How many thousands make 10,000?",
      "answer": 10,
      "solution": "10,000 ÷ 1,000 = 10 thousands."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "Write four thousand two hundred and nine in digits.",
      "answer": 4209,
      "solution": "4,000 + 200 + 0 + 9 = 4,209."
    }
  ],
