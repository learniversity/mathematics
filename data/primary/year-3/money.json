{
  "id": "primary-3-money",
  "title": "Money and Shopping Problems",
  "level": "primary-3",
  "category": "Measurement",
  "introduction": "Develop Primary 3 skills in money and shopping problems.",
  "definition": "Calculate total cost, change and the cost of multiple identical items. Convert ringgit to sen if helpful to avoid errors with decimal places. A budget is the amount available to spend.",
  "visuals": [],
  "formulas": [
    {
      "expression": "Total cost = unit price × quantity",
      "description": "For identical items."
    },
    {
      "expression": "Change = payment − total cost",
      "description": "When payment is sufficient."
    }
  ],
  "examples": [
    {
      "question": "Buy 4 pens at RM2.75 each.",
      "steps": [
        "275 sen × 4 = 1,100 sen."
      ],
      "answer": "RM11.00"
    },
    {
      "question": "Pay RM50 for items costing RM18.90 and RM12.40.",
      "steps": [
        "18.90 + 12.40 = 31.30.",
        "50.00 − 31.30 = 18.70."
      ],
      "answer": "RM18.70"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "3 notebooks at RM4.20 each. Total RM?",
      "answer": 12.6,
      "solution": "RM4.20 × 3 = RM12.60."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "RM20 − RM8.75. Change in RM?",
      "answer": 11.25,
      "solution": "RM20.00 − RM8.75 = RM11.25."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "RM12.80 + RM5.45. Total RM?",
      "answer": 18.25,
      "solution": "1,280 + 545 = 1,825 sen; 1,825 ÷ 100 = RM18.25."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "Convert 725 sen to RM.",
      "answer": 7.25,
      "solution": "725 ÷ 100 = RM7.25."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "RM30 budget, spend RM17.60. Remaining RM?",
      "answer": 12.4,
      "solution": "RM30.00 − RM17.60 = RM12.40."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "Share RM24 equally among 6 children. RM each?",
      "answer": 4,
      "solution": "RM24 ÷ 6 = RM4.00."
    }
  ],
