  "formulas": [
    {
      "expression": "7,254 = 7 × 1,000 + 2 × 100 + 5 × 10 + 4",
      "description": "Expanded form."
    }
  ],
  "examples": [
    {
      "question": "Expand 7,254.",
      "steps": [
        "7 × 1,000 = 7,000; 2 × 100 = 200; 5 × 10 = 50; 4 × 1 = 4."
      ],
      "answer": "7,000 + 200 + 50 + 4"
    },
    {
      "question": "Form 9 thousands, 0 hundreds, 6 tens and 2 ones.",
      "steps": [
