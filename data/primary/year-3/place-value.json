      "id": "q3",
      "type": "numeric",
      "question": "Tens digit of 8,035?",
      "answer": 3,
      "solution": "8,035 = 8,000 + 30 + 5; 30 = 3 × 10, so the tens digit is 3."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "6,000 + 400 + 8",
      "answer": 6408,
      "solution": "6,000 + 400 + 0 + 8 = 6,408."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "How many hundreds are in 3,000?",
      "answer": 30,
      "solution": "3,000 ÷ 100 = 30 hundreds."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "What is the value of the 2 in 9,024?",
      "answer": 20,
      "solution": "2 × 10 = 20."
