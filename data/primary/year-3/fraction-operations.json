  "formulas": [
    {
      "expression": "a/c + b/c = (a + b)/c",
      "description": "Common denominator c ≠ 0."
    },
    {
      "expression": "a/c − b/c = (a − b)/c",
      "description": "Common denominator c ≠ 0."
    }
  ],
  "examples": [
    {
      "question": "Calculate 2/7 + 3/7.",
      "steps": [
        "The denominators match.",
        "Add 2 + 3."
      ],
      "answer": "5/7"
    },
    {
      "question": "Calculate 3/4 − 1/2.",
      "steps": [
        "1/2 = 2/4.",
        "3/4 − 2/4 = 1/4."
      ],
      "answer": "1/4"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "text",
      "question": "1/5 + 2/5 (lowest terms)",
      "answer": "3/5",
      "solution": "(1+2)/5 = 3/5."
    },
    {
      "id": "q2",
      "type": "text",
      "question": "5/8 − 2/8 (lowest terms)",
      "answer": "3/8",
      "solution": "(5−2)/8 = 3/8."
    },
    {
      "id": "q3",
      "type": "text",
      "question": "1/2 + 1/4 (lowest terms)",
      "answer": "3/4",
      "solution": "2/4 + 1/4 = 3/4."
    },
    {
      "id": "q4",
      "type": "text",
      "question": "3/4 − 1/4 (lowest terms)",
      "answer": "1/2",
      "solution": "2/4 = 1/2."
    },
    {
      "id": "q5",
      "type": "text",
      "question": "1/3 + 1/6 (lowest terms)",
      "answer": "1/2",
      "solution": "2/6 + 1/6 = 3/6 = 1/2."
    },
    {
      "id": "q6",
      "type": "text",
      "question": "2/3 − 1/6 (lowest terms)",
      "answer": "1/2",
      "solution": "4/6 − 1/6 = 3/6 = 1/2."
    }
  ],
  "summary": "For fractions with the same denominator, add or subtract the numerators and keep the denominator. For unlike denominators, first convert to equivalent fractions with a common denominator. Simplify the result when possible.",
