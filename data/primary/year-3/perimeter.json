  "formulas": [
    {
      "expression": "P = sum of outside side lengths",
      "description": "For polygons."
    }
  ],
  "examples": [
    {
      "question": "Two 4 cm squares share a full side. Find the outer perimeter.",
      "steps": [
        "The result is an 8 cm by 4 cm rectangle.",
        "2 × (8 + 4) = 24."
      ],
      "answer": "24 cm"
    },
    {
      "question": "An L-shape has boundary lengths 8, 3, 5, 4, 3 and 7 cm.",
      "steps": [
        "Add all six outside lengths."
      ],
      "answer": "30 cm"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "Rectangle 9 cm by 4 cm: perimeter in cm?",
      "answer": 26,
      "solution": "2 × (9 + 4)."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "Two 3 cm squares share a full edge. Perimeter in cm?",
      "answer": 18,
      "solution": "6 + 3 + 6 + 3."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "Triangle sides 7, 8 and 9 cm. Perimeter?",
      "answer": 24,
