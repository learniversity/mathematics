  "formulas": [
    {
      "expression": "Dividend = divisor × quotient + remainder",
      "description": "For positive whole-number divisors."
    }
  ],
  "examples": [
    {
      "question": "Calculate 156 ÷ 3.",
      "steps": [
        "15 ÷ 3 = 5; subtract 15.",
        "Bring down 6; 6 ÷ 3 = 2."
      ],
      "answer": "52"
    },
    {
      "question": "Calculate 845 ÷ 4.",
      "steps": [
        "8 ÷ 4 = 2; bring down 4.",
        "4 ÷ 4 = 1; bring down 5.",
        "5 ÷ 4 = 1 remainder 1."
      ],
      "answer": "211 remainder 1"
    }
  ],
