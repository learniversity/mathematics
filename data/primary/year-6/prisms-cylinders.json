  "formulas": [
    {
      "expression": "V = cross-sectional area × length",
      "description": "Right prism or cylinder."
    },
    {
      "expression": "V = πr²h",
      "description": "Right circular cylinder."
    }
  ],
  "examples": [
    {
      "question": "A triangular prism has triangle base 6 cm, triangle height 4 cm and prism length 10 cm.",
      "steps": [
        "Cross-section area=6×4÷2=12; volume=12×10."
      ],
      "answer": "120 cm³"
    },
    {
      "question": "A cylinder has radius 5 cm and height 8 cm, π=3.14.",
      "steps": [
        "3.14×25×8."
      ],
      "answer": "628 cm³"
    }
  ],
