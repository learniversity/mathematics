  "formulas": [
    {
      "expression": "Actual length = drawing length × n",
      "description": "For scale 1:n."
    },
    {
      "expression": "Actual area = drawing area × n²",
      "description": "For scale 1:n."
    }
  ],
  "examples": [
    {
      "question": "A map scale is 1:50,000. Map distance 6 cm.",
      "steps": [
        "6×50,000=300,000 cm=3 km."
      ],
      "answer": "3 km"
    },
    {
      "question": "A room is 4 m long. Draw it at 1:50.",
      "steps": [
        "400 cm÷50."
      ],
      "answer": "8 cm"
    }
  ],
