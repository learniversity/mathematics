{
  "id": "primary-6-decimal-division",
  "title": "Dividing Decimals by Decimals",
  "level": "primary-6",
  "category": "Arithmetic",
  "introduction": "Build on earlier mathematics by studying dividing decimals by decimals.",
  "definition": "Multiply both dividend and divisor by the same power of ten until the divisor is a whole number, then divide. This preserves the quotient. The divisor must not be zero.",
  "visuals": [],
  "formulas": [
    {
      "expression": "a ÷ b = (a × k) ÷ (b × k)",
      "description": "For nonzero b and k."
    }
  ],
  "examples": [
    {
      "question": "Calculate 6.72 ÷ 0.8.",
      "steps": [
        "Multiply both by 10: 67.2 ÷ 8."
      ],
      "answer": "8.4"
    },
    {
      "question": "Calculate 0.375 ÷ 0.05.",
      "steps": [
        "Multiply both by 100: 37.5 ÷ 5."
      ],
      "answer": "7.5"
    }
  ],
