    {
      "id": "q2",
      "type": "numeric",
      "question": "Write 8,000,000 + 50,000 + 600 + 7.",
      "answer": 8050607,
      "solution": "Add the place values."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "Round 3,450,000 to nearest hundred-thousand.",
      "answer": 3500000,
      "solution": "5 ten-thousands rounds up."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "Round 9,499,999 to nearest million.",
      "answer": 9000000,
      "solution": "Less than halfway to 10 million."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "How many thousands are in 2 million?",
      "answer": 2000,
      "solution": "2,000,000 ÷ 1,000."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "What follows 9,999,999?",
      "answer": 10000000,
      "solution": "Add one."
