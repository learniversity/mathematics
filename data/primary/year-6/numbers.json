    {
      "expression": "1 million = 1,000,000",
      "description": "Place value."
    },
    {
      "expression": "10 million = 10,000,000",
      "description": "Ten groups of one million."
    }
  ],
  "examples": [
    {
      "question": "Expand 6,304,082.",
      "steps": [
        "6 million + 300 thousand + 4 thousand + 80 + 2."
      ],
      "answer": "6,000,000 + 300,000 + 4,000 + 80 + 2"
    },
    {
      "question": "Round 7,685,420 to the nearest million.",
      "steps": [
        "The hundred-thousands digit is 6, so round up."
      ],
      "answer": "8000000"
    }
  ],
