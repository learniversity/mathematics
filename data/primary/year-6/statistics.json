  "formulas": [
    {
      "expression": "Mean = Σ(xf)/Σf",
      "description": "Frequency-weighted mean."
    }
  ],
  "examples": [
    {
      "question": "Values 2,4,6 occur 1,3,2 times respectively.",
      "steps": [
        "Sum=2×1+4×3+6×2=26; count=6."
      ],
      "answer": "Mean = 13/3"
    },
    {
      "question": "Values 1,2,3 occur 2,5,1 times.",
      "steps": [
        "Eight observations; fourth and fifth both equal 2."
      ],
      "answer": "Median = 2"
    }
  ],
  "exercises": [
