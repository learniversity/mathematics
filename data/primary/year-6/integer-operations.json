  "formulas": [
    {
      "expression": "a − b = a + (−b)",
      "description": "Subtract by adding the opposite."
    },
    {
      "expression": "(−a)(−b) = ab",
      "description": "Product of two negatives."
    }
  ],
  "examples": [
    {
      "question": "Calculate −8 − (−5).",
      "steps": [
        "Subtracting −5 means adding 5."
      ],
      "answer": "−3"
    },
    {
      "question": "Calculate (−6) × (−4).",
      "steps": [
        "Matching signs give a positive result."
      ],
      "answer": "24"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "−7 + 12",
      "answer": 5,
      "solution": "Move 12 units right."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "−9 − 6",
      "answer": -15,
      "solution": "Move 6 units left."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "4 − (−8)",
      "answer": 12,
      "solution": "4 + 8."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "−8 × 7",
      "answer": -56,
      "solution": "Different signs."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "−72 ÷ −9",
      "answer": 8,
      "solution": "Matching signs."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "−3 × (4 − 9)",
      "answer": 15,
      "solution": "−3 × −5."
    }
