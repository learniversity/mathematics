  "formulas": [
    {
      "expression": "y = kx",
      "description": "Direct proportion."
    },
    {
      "expression": "y = k/x",
      "description": "Inverse proportion, x nonzero."
    }
  ],
  "examples": [
    {
      "question": "Six identical books cost RM48. Find cost of ten.",
      "steps": [
        "Unit price 48 ÷ 6 = 8; multiply by 10."
      ],
      "answer": "RM80"
    },
    {
      "question": "Four equally productive workers finish a job in 12 hours. How long for six at the same rate?",
      "steps": [
        "Fixed work = 4×12 = 48 worker-hours; divide by 6."
      ],
      "answer": "8 hours"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "5 kg costs RM35. Cost of 8 kg?",
      "answer": 56,
      "solution": "35 ÷ 5 × 8."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "3 identical taps fill a tank in 12 min. 6 taps take how many min?",
      "answer": 6,
      "solution": "3 × 12 ÷ 6."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "If y=4x, y when x=7?",
      "answer": 28,
      "solution": "4 × 7."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "If xy=60, y when x=12?",
      "answer": 5,
      "solution": "60 ÷ 12."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "A recipe for 4 uses 300 g. For 10, grams?",
      "answer": 750,
      "solution": "300 ÷ 4 × 10."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "8 workers take 9 days. 12 equally productive workers take days?",
      "answer": 6,
      "solution": "8 × 9 ÷ 12."
    }
  ],
