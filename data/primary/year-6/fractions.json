  "formulas": [
    {
      "expression": "a/b + c/d = (ad+bc)/bd",
      "description": "Nonzero denominators."
    },
    {
      "expression": "(a/b) ÷ (c/d) = ad/bc",
      "description": "Nonzero denominators and divisor."
    }
  ],
  "examples": [
    {
      "question": "Calculate 2 1/3 × 1 1/2.",
      "steps": [
        "7/3 × 3/2 = 7/2."
      ],
      "answer": "3 1/2"
    },
    {
      "question": "Calculate 5/6 − 1/4 + 1/3.",
      "steps": [
        "10/12 − 3/12 + 4/12."
      ],
      "answer": "11/12"
    }
  ],
  "exercises": [
