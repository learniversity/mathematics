  "formulas": [
    {
      "expression": "Experimental P(A) = frequency of A/number of trials",
      "description": "At least one trial."
    },
    {
      "expression": "P(A and B) = P(A)P(B)",
      "description": "Independent events."
    },
    {
      "expression": "P(A or B) = P(A)+P(B)",
      "description": "Mutually exclusive events."
    }
  ],
  "examples": [
    {
      "question": "A coin lands heads 54 times in 100 trials.",
      "steps": [
        "Experimental probability=54÷100."
      ],
      "answer": "0.54"
    },
    {
      "question": "Two independent fair coin tosses both land heads.",
      "steps": [
        "1/2×1/2."
      ],
      "answer": "1/4"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "A die shows six 18 times in 120 rolls. Experimental probability?",
      "answer": 0.15,
      "solution": "18÷120."
    },
    {
      "id": "q2",
      "type": "text",
      "question": "Two independent fair coins both tails, lowest fraction?",
      "answer": "1/4",
      "solution": "1/2×1/2."
    },
    {
      "id": "q3",
      "type": "text",
      "question": "Fair die rolls 1 or 6, lowest fraction?",
      "answer": "1/3",
      "solution": "2/6."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "Independent events have probabilities 0.5 and 0.4. Both?",
      "answer": 0.2,
      "solution": "0.5×0.4."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "Mutually exclusive events have probabilities 0.2 and 0.3. Either?",
      "answer": 0.5,
      "solution": "0.2+0.3."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "Event occurs 35 times in 50 trials. Experimental probability?",
      "answer": 0.7,
      "solution": "35÷50."
    }
  ],
  "summary": "Theoretical probability uses a mathematical model of outcomes. Experimental probability is observed frequency divided by number of trials. For independent events, the probability of both occurring is the product of their probabilities. For mutually exclusive events, the probability of either is the sum.",
