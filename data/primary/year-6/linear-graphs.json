  "formulas": [
    {
      "expression": "y = mx + c",
      "description": "Straight-line equation."
    },
    {
      "expression": "m = (y₂−y₁)/(x₂−x₁)",
      "description": "Different x-coordinates."
    }
  ],
  "examples": [
    {
      "question": "Complete the table for y=2x+1 at x=0,1,2.",
      "steps": [
        "Substitute each x-value."
      ],
      "answer": "1, 3, 5"
    },
    {
      "question": "Find the gradient between (1,3) and (4,9).",
      "steps": [
        "Change in y=6; change in x=3."
      ],
      "answer": "2"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "In y=3x+2, y when x=4?",
      "answer": 14,
      "solution": "12+2."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "In y=5x−1, gradient?",
      "answer": 5,
      "solution": "Coefficient of x."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "In y=2x+7, y-intercept?",
      "answer": 7,
      "solution": "Set x=0."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "Gradient between (0,1) and (3,10)?",
      "answer": 3,
      "solution": "9÷3."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "In y=−2x+5, y when x=3?",
      "answer": -1,
      "solution": "−6+5."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "In y=4x−8, x when y=0?",
      "answer": 2,
      "solution": "4x=8."
