  "formulas": [],
  "examples": [
    {
      "question": "Is 29 prime?",
      "steps": [
        "Check divisibility by 2, 3 and 5, the primes not exceeding its square root.",
        "None divides 29 exactly."
      ],
      "answer": "yes"
    },
    {
      "question": "Classify 21.",
      "steps": [
        "21 = 3 × 7, so it has factors besides 1 and itself."
      ],
      "answer": "composite"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "Smallest prime number?",
      "answer": 2,
      "solution": "2 has factors 1 and 2."
    },
    {
      "id": "q2",
      "type": "text",
      "question": "Is 1 prime? yes/no",
      "answer": "no",
      "solution": "It has only one positive factor."
    },
    {
      "id": "q3",
      "type": "text",
      "question": "Classify 17: prime or composite.",
      "answer": "prime",
      "solution": "Only 1 and 17 divide it."
    },
    {
      "id": "q4",
      "type": "text",
      "question": "Classify 49: prime or composite.",
      "answer": "composite",
      "solution": "49 = 7 × 7."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "Only even prime number?",
      "answer": 2,
      "solution": "Larger even numbers have 2 as a factor."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "How many positive factors does any prime have?",
      "answer": 2,
      "solution": "1 and the number itself."
    }
  ],
  "summary": "A prime number is a whole number greater than 1 with exactly two positive factors: 1 and itself. A composite number has more than two positive factors. Zero and one are neither prime nor composite.",
