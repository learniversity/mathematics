  "examples": [
    {
      "question": "Classify a 45° angle.",
      "steps": [
        "45° is less than 90°."
      ],
      "answer": "acute"
    },
    {
      "question": "How many degrees are in a half turn?",
      "steps": [
        "A full turn is 360°; divide by 2."
      ],
      "answer": "180"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "Degrees in a right angle?",
      "answer": 90,
      "solution": "A quarter turn."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "Degrees in a full turn?",
      "answer": 360,
      "solution": "Four right angles."
    },
    {
      "id": "q3",
      "type": "text",
      "question": "Classify 60°: acute, right or obtuse.",
      "answer": "acute",
      "solution": "0° < 60° < 90°."
    },
    {
      "id": "q4",
      "type": "text",
      "question": "Classify 120°: acute, right or obtuse.",
      "answer": "obtuse",
      "solution": "90° < 120° < 180°."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "Degrees in three quarter turns?",
      "answer": 270,
      "solution": "3 × 90°."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "Degrees in a straight angle?",
      "answer": 180,
      "solution": "Half a full turn."
    }
