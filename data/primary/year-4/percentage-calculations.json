  "formulas": [
    {
      "expression": "Part = (p/100) × whole",
      "description": "Find p percent of a quantity."
    }
  ],
  "examples": [
    {
      "question": "Find 15% of 240.",
      "steps": [
        "10% of 240 = 24; 5% = 12.",
        "24 + 12 = 36."
      ],
      "answer": "36"
    },
    {
      "question": "Find 25% of RM80.",
      "steps": [
        "25% is one quarter.",
        "80 ÷ 4."
      ],
      "answer": "RM20"
    }
  ],
