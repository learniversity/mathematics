  "formulas": [
    {
      "expression": "n a/b = (n × b + a)/b",
      "description": "Convert mixed numbers, where b > 0 and 0 ≤ a < b."
    }
  ],
  "examples": [
    {
      "question": "Convert 7/3 to a mixed number.",
      "steps": [
        "7 ÷ 3 = 2 remainder 1."
      ],
      "answer": "2 1/3"
    },
    {
      "question": "Convert 2 3/5 to an improper fraction.",
      "steps": [
        "2 × 5 + 3 = 13.",
        "Keep the denominator 5."
      ],
      "answer": "13/5"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "text",
      "question": "Is 3/7 proper or improper?",
      "answer": "proper",
      "solution": "3 is less than 7."
    },
    {
      "id": "q2",
      "type": "text",
      "question": "Is 9/4 proper or improper?",
      "answer": "improper",
      "solution": "9 is greater than 4."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "Whole-number part of 11/4?",
      "answer": 2,
      "solution": "11 ÷ 4 = 2 remainder 3."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "Numerator of 3 2/5 as an improper fraction?",
      "answer": 17,
      "solution": "3 × 5 + 2 = 17."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "Convert 6/3 to a whole number.",
      "answer": 2,
      "solution": "6 ÷ 3 = 2."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "Remainder numerator of 13/5 as a mixed number?",
      "answer": 3,
      "solution": "13 = 2 × 5 + 3."
    }
  ],
  "summary": "A proper fraction has a numerator smaller than its positive denominator. An improper fraction has numerator at least as large as its denominator. A mixed number combines a whole number and a proper fraction.",
