  "title": "Order of Operations",
  "level": "primary-4",
  "category": "Arithmetic",
  "introduction": "Learn order of operations through explanations and practice.",
  "definition": "Calculate brackets first, then multiplication and division from left to right, then addition and subtraction from left to right. Operations at the same priority are not automatically evaluated in symbol order.",
  "visuals": [],
  "formulas": [],
  "examples": [
    {
      "question": "Calculate 8 + 4 × 5.",
      "steps": [
        "4 × 5 = 20 first.",
        "8 + 20 = 28."
      ],
      "answer": "28"
    },
    {
      "question": "Calculate (8 + 4) × 5.",
      "steps": [
        "8 + 4 = 12 first.",
        "12 × 5 = 60."
      ],
      "answer": "60"
    }
  ],
