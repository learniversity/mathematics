  "formulas": [
    {
      "expression": "P(event) = favourable outcomes ÷ total outcomes",
      "description": "For equally likely outcomes."
    }
  ],
  "examples": [
    {
      "question": "A fair six-sided die is rolled. Find probability of rolling a 4.",
      "steps": [
        "There is one favourable outcome out of six."
      ],
      "answer": "1/6"
    },
    {
      "question": "A bag contains 3 red and 5 blue counters. One is drawn uniformly at random.",
      "steps": [
        "There are 8 counters in total.",
        "Probability of red is 3 out of 8."
      ],
      "answer": "3/8"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "text",
      "question": "A fair coin: probability of heads in lowest terms?",
      "answer": "1/2",
      "solution": "One of two equally likely outcomes."
    },
    {
      "id": "q2",
      "type": "text",
      "question": "Fair die: probability of an even number in lowest terms?",
      "answer": "1/2",
      "solution": "3 favourable outcomes out of 6."
    },
    {
      "id": "q3",
      "type": "text",
      "question": "A bag has 4 red and 6 blue counters. Probability of red in lowest terms?",
      "answer": "2/5",
      "solution": "4/10 = 2/5."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "Probability of an impossible event?",
      "answer": 0,
      "solution": "No favourable outcome."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "Probability of a certain event?",
      "answer": 1,
      "solution": "All outcomes are favourable."
    },
    {
      "id": "q6",
      "type": "text",
      "question": "Fair die: probability of rolling 1 or 2, lowest terms?",
      "answer": "1/3",
      "solution": "2/6 = 1/3."
    }
  ],
  "summary": "Probability describes how likely an event is. A probability of 0 means impossible and 1 means certain. For equally likely outcomes, divide the number of favourable outcomes by the total number of possible outcomes.",
