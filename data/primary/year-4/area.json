    {
      "question": "An L-shape is an 8 cm by 6 cm rectangle with a 3 cm by 2 cm corner removed.",
      "steps": [
        "8 × 6 = 48; 3 × 2 = 6.",
        "48 − 6."
      ],
      "answer": "42 cm²"
    }
