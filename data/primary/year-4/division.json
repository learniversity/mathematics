{
  "id": "primary-4-division",
  "title": "Long Division by Two-Digit Numbers",
  "level": "primary-4",
  "category": "Arithmetic",
  "introduction": "Build Primary 4 mathematical understanding through long division by two-digit numbers.",
  "definition": "Estimate how many times the divisor fits into the leading digits. Multiply, subtract and bring down the next digit. Continue until all digits have been used. The remainder must be smaller than the divisor.",
  "visuals": [],
  "formulas": [
    {
      "expression": "N = d × q + r, 0 ≤ r < d",
      "description": "For positive divisor d."
    }
  ],
  "examples": [
    {
      "question": "Calculate 936 ÷ 24.",
      "steps": [
        "93 ÷ 24 gives 3; 93 − 72 = 21.",
        "Bring down 6 to make 216.",
        "216 ÷ 24 = 9."
      ],
      "answer": "39"
    },
    {
      "question": "Divide 1,250 by 36.",
      "steps": [
        "36 × 34 = 1,224.",
        "1,250 − 1,224 = 26."
      ],
      "answer": "34 remainder 26"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "480 ÷ 12",
      "answer": 40,
      "solution": "480 ÷ 12 = 40 because 12 × 40 = 480."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "875 ÷ 25",
      "answer": 35,
      "solution": "875 ÷ 25 = (750 ÷ 25) + (125 ÷ 25) = 30 + 5 = 35."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "1,296 ÷ 18",
      "answer": 72,
      "solution": "1,296 ÷ 18 = (1,260 ÷ 18) + (36 ÷ 18) = 70 + 2 = 72."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "2,340 ÷ 36",
      "answer": 65,
      "solution": "2,340 ÷ 36 = (2,160 ÷ 36) + (180 ÷ 36) = 60 + 5 = 65."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "Whole-number quotient of 765 ÷ 22?",
      "answer": 34,
      "solution": "765 = 22 × 34 + 17; quotient = 34."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "Remainder of 765 ÷ 22?",
      "answer": 17,
      "solution": "22 × 34 = 748; 765 − 748 = 17."
    }
  ],
  "summary": "Estimate how many times the divisor fits into the leading digits. Multiply, subtract and bring down the next digit. Continue until all digits have been used. The remainder must be smaller than the divisor.",
