  "formulas": [
    {
      "expression": "a/b + c/d = (ad + bc)/(bd)",
      "description": "Nonzero denominators."
    },
    {
      "expression": "a/b − c/d = (ad − bc)/(bd)",
      "description": "Nonzero denominators."
    }
  ],
  "examples": [
    {
      "question": "Calculate 2 1/3 + 1 3/4.",
      "steps": [
        "7/3 + 7/4 = 28/12 + 21/12.",
        "49/12 = 4 1/12."
      ],
      "answer": "4 1/12"
    },
    {
      "question": "Calculate 3 1/4 − 1 3/4.",
      "steps": [
        "13/4 − 7/4 = 6/4.",
        "Simplify to 3/2."
      ],
      "answer": "1 1/2"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "text",
      "question": "1/4 + 2/3, lowest terms.",
      "answer": "11/12",
      "solution": "3/12 + 8/12."
    },
    {
      "id": "q2",
      "type": "text",
      "question": "5/6 − 1/4, lowest terms.",
      "answer": "7/12",
      "solution": "10/12 − 3/12."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "1 1/2 + 2 1/2, whole number.",
      "answer": 4,
      "solution": "1 + 2 + 1."
    },
    {
      "id": "q4",
      "type": "text",
      "question": "3 1/3 − 1 2/3, mixed number in lowest terms.",
      "answer": "1 2/3",
      "solution": "10/3 − 5/3 = 5/3."
    },
    {
      "id": "q5",
      "type": "text",
      "question": "2/5 + 1/10, lowest terms.",
      "answer": "1/2",
      "solution": "4/10 + 1/10."
    },
    {
      "id": "q6",
      "type": "text",
      "question": "7/8 − 3/8, lowest terms.",
      "answer": "1/2",
      "solution": "4/8 = 1/2."
    }
  ],
