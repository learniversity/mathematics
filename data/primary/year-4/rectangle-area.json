  "formulas": [
    {
      "expression": "A = l × w",
      "description": "Rectangle."
    },
    {
      "expression": "A = s × s = s²",
      "description": "Square."
    }
  ],
  "examples": [
    {
      "question": "Find the area of a 6 cm by 4 cm rectangle.",
      "steps": [
        "There are 4 rows of 6 square centimetres.",
        "6 × 4 = 24."
      ],
      "answer": "24 cm²"
    },
    {
      "question": "Find the area of a square of side 5 cm.",
      "steps": [
        "5 × 5 = 25."
      ],
      "answer": "25 cm²"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "Rectangle 8 cm by 3 cm: area in cm²?",
      "answer": 24,
      "solution": "8 × 3."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "Square side 7 cm: area in cm²?",
      "answer": 49,
      "solution": "7 × 7."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "Rectangle area 36 cm², width 4 cm. Length?",
      "answer": 9,
      "solution": "36 ÷ 4."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "5 rows of 6 unit squares. Area?",
      "answer": 30,
      "solution": "5 × 6."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "Two non-overlapping rectangles have areas 12 and 20 cm². Total?",
      "answer": 32,
      "solution": "12 + 20."
    }
  ],
  "summary": "Area measures the size of a flat region. Count equal unit squares to measure area. For rectangles, multiply length by width in the same unit; the result is in square units.",
