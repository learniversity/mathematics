  "examples": [
    {
      "question": "Convert 4.25 km to metres.",
      "steps": [
        "1 km = 1,000 m.",
        "4.25 × 1,000."
      ],
      "answer": "4,250 m"
    },
    {
      "question": "Convert 2 kg 75 g to kilograms.",
      "steps": [
        "75 g = 0.075 kg.",
        "2 + 0.075."
      ],
      "answer": "2.075 kg"
    }
  ],
