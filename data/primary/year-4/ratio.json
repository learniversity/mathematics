  "formulas": [
    {
      "expression": "a:b = (a ÷ k):(b ÷ k)",
      "description": "Common positive factor k."
    },
    {
      "expression": "One part = total ÷ sum of ratio terms",
      "description": "When sharing a total in a ratio."
    }
  ],
  "examples": [
    {
      "question": "Simplify 12 red counters : 8 blue counters.",
      "steps": [
        "Divide both numbers by 4."
      ],
      "answer": "3:2"
    },
    {
      "question": "The ratio of red to blue is 2:3. There are 10 red counters.",
      "steps": [
        "2 parts represent 10, so each part is 5.",
        "3 parts represent 15."
      ],
      "answer": "15"
    }
  ],
  "exercises": [
