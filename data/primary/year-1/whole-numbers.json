{
  "id": "primary-1-whole-numbers",
  "title": "Whole Numbers",
  "level": "primary-1",
  "category": "Arithmetic",
  "introduction": "Explore whole numbers through definitions, examples and practice.",
  "definition": "Whole numbers are 0, 1, 2, 3 and so on. In Year 1, read, write, count, compare and represent whole numbers from 0 to 100. Ten ones form one ten, and ten tens form one hundred.",
  "formulas": [],
  "examples": [
    {
      "question": "What number comes immediately after 19?",
      "steps": [
        "19 is one less than 20.",
        "Add one to 19."
      ],
      "answer": "20"
    },
    {
      "question": "Represent 47 using tens and ones.",
      "steps": [
        "Make four groups of ten.",
        "Add seven individual ones."
      ],
      "answer": "4 tens and 7 ones"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "What comes after 9?",
      "answer": 10,
      "solution": "Answer: 10"
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "What comes before 15?",
      "answer": 14,
      "solution": "Answer: 14"
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "How many tens are in 30?",
      "answer": 3,
      "solution": "Answer: 3"
    },
    {
      "question": "Write ninety-six in digits.",
      "answer": 96,
      "type": "numeric",
      "solution": "Nine tens and six ones.",
      "id": "q4"
    },
    {
      "question": "What comes after 99?",
      "answer": 100,
      "type": "numeric",
      "solution": "99 + 1 = 100.",
      "id": "q5"
    },
    {
      "question": "What number has 7 tens and 3 ones?",
      "answer": 73,
      "type": "numeric",
      "solution": "70 + 3.",
      "id": "q6"
    },
    {
      "question": "Write 58 in words.",
      "answer": "fifty-eight",
      "type": "text",
      "solution": "Five tens and eight ones.",
      "id": "q7"
    },
    {
      "question": "How many tens make 100?",
      "answer": 10,
      "type": "numeric",
      "solution": "100 ÷ 10 = 10.",
      "id": "q8"
    },
    {
      "id": "q9",
      "type": "numeric",
      "question": "Which is a better estimate for 19 beads: 10 or 20?",
      "answer": 20,
      "solution": "19 is closer to 20. Answer: 20"
    },
    {
      "id": "q10",
      "type": "numeric",
      "question": "Estimate the number of objects in three groups of about 10.",
      "answer": 30,
      "solution": "3 × 10 = 30. Answer: 30"
    }
  ],
  "summary": "Whole numbers are 0, 1, 2, 3 and so on. In Year 1, read, write, count, compare and represent whole numbers from 0 to 100. Ten ones form one ten, and ten tens form one hundred.",
