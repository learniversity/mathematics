  "formulas": [
    {
      "expression": "Length = end reading − start reading",
      "description": "Both readings must use the same unit."
    },
    {
      "expression": "1 m = 100 cm",
      "description": "One metre equals 100 centimetres."
    }
  ],
  "examples": [
    {
      "question": "A pencil starts at 0 cm and ends at 8 cm.",
      "steps": [
        "Subtract the starting reading from the ending reading."
      ],
      "answer": "8 cm"
    },
    {
      "question": "A line starts at 2 cm and ends at 9 cm.",
      "steps": [
        "9 − 2 = 7."
      ],
      "answer": "7 cm"
    }
  ],
