  "examples": [
    {
      "question": "A recipe uses flour and sugar in ratio 5:2. Flour is 350 g.",
      "steps": [
        "One part = 350 ÷ 5 = 70 g; sugar = 2 × 70."
      ],
      "answer": "140 g"
    },
    {
      "question": "Share RM96 in ratio 5:3.",
      "steps": [
        "8 parts; each part RM12."
      ],
      "answer": "RM60 and RM36"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "text",
      "question": "Simplify 24:36.",
      "answer": "2:3",
      "solution": "Divide both by 12."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "Share 84 in ratio 3:4. Larger share?",
      "answer": 48,
      "solution": "84 ÷ 7 × 4."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "Ratio 2:5; first quantity 14. Second?",
      "answer": 35,
      "solution": "14 ÷ 2 × 5."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "Four identical books cost RM28. Six cost RM?",
      "answer": 42,
      "solution": "28 ÷ 4 × 6."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "Recipe for 3 people needs 150 g. For 8 people, grams?",
      "answer": 400,
      "solution": "150 ÷ 3 × 8."
    },
    {
      "id": "q6",
      "type": "text",
      "question": "Simplify 1.5 m : 50 cm.",
      "answer": "3:1",
      "solution": "150:50."
    }
  ],
  "summary": "A ratio compares quantities in a fixed order. Equivalent ratios are formed by multiplying both terms by the same positive factor. In direct proportion, one quantity is a constant multiple of another.",
