  "examples": [
    {
      "question": "Solve 5x + 7 = 42.",
      "steps": [
        "Subtract 7: 5x = 35; divide by 5."
      ],
      "answer": "x = 7"
    },
    {
      "question": "Solve 3x − 4 = 20.",
      "steps": [
        "Add 4: 3x = 24; divide by 3."
      ],
      "answer": "x = 8"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "x + 19 = 45. Find x.",
      "answer": 26,
      "solution": "45 − 19."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "7x = 63. Find x.",
      "answer": 9,
      "solution": "63 ÷ 7."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "x/4 = 8. Find x.",
      "answer": 32,
      "solution": "8 × 4."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "4x + 5 = 29. Find x.",
      "answer": 6,
      "solution": "(29 − 5) ÷ 4."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "6x − 8 = 34. Find x.",
      "answer": 7,
      "solution": "(34 + 8) ÷ 6."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "2(x + 3) = 18. Find x.",
      "answer": 6,
      "solution": "18 ÷ 2 − 3."
    }
