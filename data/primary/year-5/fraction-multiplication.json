  "formulas": [
    {
      "expression": "(a/b) × (c/d) = ac/bd",
      "description": "Nonzero denominators."
    }
  ],
  "examples": [
    {
      "question": "Calculate 2/3 × 3/5.",
      "steps": [
        "2 × 3 = 6; 3 × 5 = 15.",
        "6/15 simplifies to 2/5."
      ],
      "answer": "2/5"
    },
    {
      "question": "Find 3/4 of 28.",
      "steps": [
        "28 ÷ 4 = 7.",
        "7 × 3 = 21."
      ],
      "answer": "21"
    }
  ],
  "exercises": [
