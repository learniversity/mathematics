    {
      "question": "Factorise 84 into primes.",
      "steps": [
        "84 = 2 × 42 = 2 × 2 × 21 = 2 × 2 × 3 × 7."
      ],
      "answer": "2 × 2 × 3 × 7"
    },
    {
      "question": "Is 738 divisible by 9?",
      "steps": [
        "7 + 3 + 8 = 18, which is divisible by 9."
      ],
      "answer": "yes"
    }
