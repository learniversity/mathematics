      "id": "q1",
      "type": "numeric",
      "question": "Sector for 50% of a circle, in degrees?",
      "answer": 180,
      "solution": "360 × 0.5."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "Sector for 25%, in degrees?",
      "answer": 90,
      "solution": "360 ÷ 4."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "A pie chart shows 120 people; 30% chose A. Number?",
      "answer": 36,
      "solution": "120 × 0.3."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "A 72° sector represents what percent? Number only.",
      "answer": 20,
      "solution": "72 ÷ 360 × 100."
