  "examples": [
    {
      "question": "A pie chart represents 80 pupils; a sector is 25%.",
      "steps": [
        "80 × 0.25."
      ],
      "answer": "20 pupils"
    },
    {
      "question": "A line graph rises from 15 to 27 units.",
      "steps": [
        "27 − 15."
      ],
      "answer": "12 units"
