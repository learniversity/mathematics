  "formulas": [
    {
      "expression": "Elapsed time = finish − start",
      "description": "Account for date changes."
    },
    {
      "expression": "1 h = 60 min",
      "description": "Time conversion."
    }
  ],
  "examples": [
    {
      "question": "A train leaves 08:47 and arrives 11:23.",
      "steps": [
        "08:47 to 09:00 = 13 min; 09:00 to 11:00 = 120 min; add 23 min."
      ],
      "answer": "156 minutes"
    },
    {
      "question": "A bus leaves 23:40 and travels 2 h 35 min.",
      "steps": [
        "23:40 + 20 min = midnight; remaining 2 h 15 min."
      ],
      "answer": "02:15 next day"
    },
    {
      "question": "Add 1.5 hours and 45 minutes.",
      "steps": [
        "1.5 hours = 90 minutes.",
        "90 + 45 = 135 minutes."
      ],
      "answer": "2 hours 15 minutes"
    }
  ],
