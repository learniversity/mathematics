      "question": "Decrease 320 by 25%.",
      "answer": 240,
      "solution": "320 × 0.75."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "Increase from 50 to 60, percentage (number only)?",
      "answer": 20,
      "solution": "10 ÷ 50 × 100."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "Decrease from 200 to 170, percentage (number only)?",
      "answer": 15,
