  "formulas": [
    {
      "expression": "Percentage change = (new − original)/original × 100%",
      "description": "Signed change."
    },
    {
      "expression": "New value = original × (1 ± rate)",
      "description": "Rate as decimal; choose sign."
    }
  ],
  "examples": [
    {
      "question": "Increase 240 by 15%.",
      "steps": [
        "15% of 240 = 36; add 36."
      ],
      "answer": "276"
    },
    {
      "question": "A value decreases from 80 to 60. Find the percentage decrease.",
      "steps": [
        "Decrease = 20; 20 ÷ 80 × 100."
      ],
      "answer": "25%"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "Increase 150 by 20%.",
