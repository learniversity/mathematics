{
  "id": "primary-5-percent-change",
  "title": "Percentage Increase and Decrease",
  "level": "primary-5",
  "category": "Arithmetic",
  "introduction": "Build on earlier mathematics by studying percentage increase and decrease.",
  "definition": "Percentage change compares a change with the original nonzero quantity. For an increase, multiply the original value by 1 plus the rate; for a decrease, multiply by 1 minus the rate. Express the rate as a decimal.",
