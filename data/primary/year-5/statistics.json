  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "Median of 4, 2, 9, 6, 7?",
      "answer": 6,
      "solution": "Sorted: 2,4,6,7,9."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "Median of 2, 4, 8, 10?",
      "answer": 6,
      "solution": "(4 + 8) ÷ 2."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "Mean of 12, 15, 18?",
      "answer": 15,
      "solution": "45 ÷ 3."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "Mode of 3, 4, 4, 6, 9?",
      "answer": 4,
      "solution": "Occurs twice."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "Range of 25, 14, 36, 20?",
      "answer": 22,
      "solution": "36 − 14."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "Five values have mean 12. Sum?",
      "answer": 60,
      "solution": "5 × 12."
