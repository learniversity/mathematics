  "introduction": "Build on earlier mathematics by studying number sequences and general rules.",
  "definition": "A sequence is an ordered list of terms. An arithmetic sequence has a constant difference between consecutive terms. Its nth term can be calculated from its first term and common difference.",
  "visuals": [],
  "formulas": [
    {
      "expression": "aₙ = a₁ + (n−1)d",
      "description": "Arithmetic sequence."
    }
  ],
  "examples": [
    {
      "question": "Find the 10th term of 5, 8, 11, 14, ...",
      "steps": [
        "First term 5, common difference 3; 5 + 9 × 3."
      ],
      "answer": "32"
    },
    {
      "question": "Find the rule of 12, 17, 22, 27, ...",
      "steps": [
        "Common difference is 5; nth term = 12 + (n−1) × 5."
      ],
      "answer": "5n + 7"
    }
  ],
