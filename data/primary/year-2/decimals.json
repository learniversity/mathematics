  "formulas": [
    {
      "expression": "1/10 = 0.1",
      "description": "One tenth."
    },
    {
      "expression": "10 × 0.1 = 1",
      "description": "Ten tenths make one whole."
    }
  ],
  "examples": [
    {
      "question": "Write 3 tenths as a decimal.",
      "steps": [
        "3 tenths means 3/10."
      ],
      "answer": "0.3"
    },
    {
      "question": "Write 1 whole and 6 tenths.",
      "steps": [
        "One whole is 1; six tenths is 0.6."
      ],
      "answer": "1.6"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "Write 7/10 as a decimal.",
      "answer": 0.7,
      "solution": "Seven tenths is 0.7."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "How many tenths make one whole?",
      "answer": 10,
      "solution": "10/10 = 1."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "What is the tenths digit in 2.4?",
      "answer": 4,
      "solution": "Read the first digit after the point."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "Write 5 tenths as a decimal.",
      "answer": 0.5,
      "solution": "5/10 = 0.5."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "Write 3 wholes and 2 tenths as a decimal.",
      "answer": 3.2,
      "solution": "3 + 0.2 = 3.2."
    }
  ],
  "summary": "A tenth is one of ten equal parts of a whole. In decimal notation, the first digit to the right of the decimal point represents tenths. Ten tenths make one whole.",
