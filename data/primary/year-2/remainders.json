  "formulas": [
    {
      "expression": "Dividend = divisor × quotient + remainder",
      "description": "For whole-number division with a positive divisor."
    }
  ],
  "examples": [
    {
      "question": "Divide 17 by 5.",
      "steps": [
        "Three complete groups of 5 make 15.",
        "17 − 15 = 2."
      ],
      "answer": "3 remainder 2"
    },
    {
      "question": "Make groups of 4 from 23 objects.",
      "steps": [
        "5 × 4 = 20.",
        "23 − 20 = 3."
      ],
      "answer": "5 groups, 3 left over"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "What is the remainder when 13 is divided by 4?",
      "answer": 1,
      "solution": "13 = 4 × 3 + 1."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "How many complete groups of 5 can be made from 27?",
      "answer": 5,
      "solution": "5 × 5 = 25, with 2 left."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "What is the remainder when 29 is divided by 6?",
      "answer": 5,
      "solution": "29 = 6 × 4 + 5."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "What is the remainder when 24 is divided by 8?",
      "answer": 0,
      "solution": "24 = 8 × 3."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "How many complete groups of 3 can be made from 20?",
      "answer": 6,
      "solution": "20 = 3 × 6 + 2."
    }
  ],
  "summary": "Sometimes equal grouping leaves some objects unused. The remainder is the amount left after making as many complete groups as possible. It must be less than the positive divisor.",
