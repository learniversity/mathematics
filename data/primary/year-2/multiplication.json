  "formulas": [
    {
      "expression": "a × b = b × a",
      "description": "Changing the order of factors does not change the product."
    },
    {
      "expression": "a × 1 = a",
      "description": "Multiplication by one."
    },
    {
      "expression": "a × 0 = 0",
      "description": "Multiplication by zero."
    }
  ],
  "examples": [
    {
      "question": "Find 6 × 7.",
      "steps": [
        "Count six groups of seven: 7, 14, 21, 28, 35, 42."
      ],
      "answer": "42"
    },
    {
      "question": "There are 8 packets with 5 biscuits each.",
      "steps": [
        "8 groups of 5 = 8 × 5."
      ],
      "answer": "40"
    }
  ],
