  "formulas": [
    {
      "expression": "P = sum of side lengths",
      "description": "Perimeter of a polygon."
    },
    {
      "expression": "P = 4 × s",
      "description": "Square with side s."
    },
    {
      "expression": "P = 2 × (l + w)",
      "description": "Rectangle with length l and width w."
    }
  ],
  "examples": [
    {
      "question": "Find the perimeter of a rectangle 6 cm by 3 cm.",
      "steps": [
        "The opposite sides are equal.",
        "6 + 3 + 6 + 3 = 18."
      ],
      "answer": "18 cm"
    },
    {
      "question": "A square has side length 4 cm.",
      "steps": [
        "Four equal sides: 4 × 4 = 16."
      ],
      "answer": "16 cm"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "A square has side 5 cm. Perimeter in cm?",
      "answer": 20,
      "solution": "4 × 5 = 20."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "A rectangle is 7 cm by 2 cm. Perimeter in cm?",
      "answer": 18,
      "solution": "2 × (7 + 2) = 18."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "Triangle sides are 3, 4 and 5 cm. Perimeter in cm?",
      "answer": 12,
      "solution": "3 + 4 + 5 = 12."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "A square has perimeter 24 cm. Side length in cm?",
      "answer": 6,
      "solution": "24 ÷ 4 = 6."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "A rectangle has sides 8 cm and 4 cm. Perimeter in cm?",
      "answer": 24,
      "solution": "2 × (8 + 4) = 24."
    }
  ],
  "summary": "Perimeter is the total distance around the boundary of a closed flat shape. For a polygon, add the lengths of all sides using the same unit.",
