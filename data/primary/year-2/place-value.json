  "formulas": [
    {
      "expression": "462 = 4 × 100 + 6 × 10 + 2",
      "description": "Expanded form."
    },
    {
      "expression": "10 tens = 1 hundred",
      "description": "Regrouping."
    }
  ],
  "examples": [
    {
      "question": "Expand 462.",
      "steps": [
        "4 hundreds = 400.",
        "6 tens = 60.",
        "2 ones = 2."
      ],
      "answer": "400 + 60 + 2"
    },
    {
      "question": "Form a number using 7 hundreds, 0 tens and 3 ones.",
      "steps": [
        "700 + 0 + 3 = 703."
      ],
      "answer": "703"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "What is the value of 8 in 826?",
      "answer": 800,
      "solution": "8 is in the hundreds place."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "What is the value of 6 in 364?",
      "answer": 60,
      "solution": "6 is in the tens place."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "What digit is in the ones place of 907?",
      "answer": 7,
      "solution": "Read the rightmost digit."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "400 + 30 + 9",
      "answer": 439,
      "solution": "Combine the place values."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "6 hundreds and 5 ones make what number?",
      "answer": 605,
      "solution": "600 + 0 + 5 = 605."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "How many tens are represented by the tens digit in 572?",
      "answer": 7,
      "solution": "The tens digit is 7."
    }
  ],
  "summary": "Place value is the value of a digit determined by its position. In a three-digit number, the positions from left to right are hundreds, tens and ones. A zero holds an empty place.",
