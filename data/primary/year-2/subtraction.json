  "title": "Subtraction within 1,000",
  "level": "primary-2",
  "category": "Arithmetic",
  "introduction": "Build on Primary 1 knowledge and practise subtraction within 1,000.",
  "definition": "Subtraction finds a difference or the quantity remaining. Align place values. If a digit is too small to subtract, regroup from the next place; check by adding the difference back to the subtracted number.",
  "visuals": [],
  "formulas": [
    {
      "expression": "a − b = c",
      "description": "The result is the difference."
    },
    {
      "expression": "c + b = a",
      "description": "Check subtraction using addition."
    }
  ],
  "examples": [
    {
      "question": "Calculate 532 − 178.",
      "steps": [
        "Regroup one ten: 12 − 8 = 4.",
        "Regroup one hundred: 12 − 7 = 5.",
        "Hundreds: 4 − 1 = 3."
      ],
      "answer": "354"
    },
    {
      "question": "Calculate 600 − 247.",
      "steps": [
        "Regroup one hundred into ten tens, then one ten into ten ones.",
        "Ones: 10 − 7 = 3; tens: 9 − 4 = 5; hundreds: 5 − 2 = 3."
      ],
      "answer": "353"
    }
  ],
