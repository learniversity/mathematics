  "formulas": [],
  "examples": [
    {
      "question": "A pictograph has 4 symbols, each worth 2 pupils.",
      "steps": [
        "Multiply the number of symbols by the key.",
        "4 × 2 = 8."
      ],
      "answer": "8"
    },
    {
      "question": "A bar chart shows red = 8, blue = 5, green = 3.",
      "steps": [
        "Add the counts.",
        "8 + 5 + 3 = 16."
      ],
      "answer": "16"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "A tally has two groups of five and three extra marks. Total?",
      "answer": 13,
      "solution": "5 + 5 + 3 = 13 marks."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "Each picture represents 3 objects. Five pictures represent how many?",
      "answer": 15,
      "solution": "5 × 3 = 15 objects."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "Apples: 9, pears: 6. How many more apples?",
      "answer": 3,
      "solution": "9 − 6 = 3 apples."
    },
    {
      "id": "q4",
      "type": "text",
      "question": "Red: 4, blue: 9, green: 7. Which is most popular?",
      "answer": "blue",
      "solution": "9 > 7 > 4; blue has the most votes."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "Red: 4, blue: 9, green: 7. Total votes?",
      "answer": 20,
      "solution": "4 + 9 + 7 = 20 votes."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "A bar chart scale counts in twos. A bar reaches the fourth interval. Value?",
      "answer": 8,
      "solution": "4 × 2 = 8."
    }
  ],
  "summary": "A tally records counts using marks. A pictograph uses pictures with a key. A bar chart uses bars of equal width whose lengths represent quantities on a consistent scale.",
