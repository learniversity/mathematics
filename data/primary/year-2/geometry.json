  "examples": [
    {
      "question": "Is a circle a polygon?",
      "steps": [
        "Its boundary is curved, not straight."
      ],
      "answer": "No"
    },
    {
      "question": "How many sides and vertices has a pentagon?",
      "steps": [
        "Count its five segments and the corners where they meet."
      ],
      "answer": "5 sides and 5 vertices"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "How many endpoints has a line segment?",
      "answer": 2,
      "solution": "A segment has two endpoints."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "How many vertices has a quadrilateral?",
      "answer": 4,
      "solution": "A quadrilateral has four sides and four vertices."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "How many right angles has a rectangle?",
      "answer": 4,
      "solution": "Each corner is a right angle."
    },
    {
      "id": "q4",
      "type": "text",
      "question": "Is a circle a polygon? Write yes or no.",
      "answer": "no",
      "solution": "A circle does not have straight sides."
    },
    {
      "id": "q5",
      "type": "text",
      "question": "Name a polygon with six sides.",
      "answer": "hexagon",
      "solution": "Hexa means six."
