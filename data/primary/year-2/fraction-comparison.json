  "formulas": [
    {
      "expression": "a/b = (a × k)/(b × k)",
      "description": "Multiply numerator and denominator by the same nonzero number."
    }
  ],
  "examples": [
    {
      "question": "Compare 2/5 and 4/5.",
      "steps": [
        "The denominator is the same.",
        "Four fifths is more than two fifths."
      ],
      "answer": "2/5 < 4/5"
    },
    {
      "question": "Complete 1/2 = ?/4.",
      "steps": [
        "Double the numerator and denominator."
      ],
      "answer": "2"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "Which numerator is larger: in 1/6 or 5/6?",
      "answer": 5,
      "solution": "5 > 1."
    },
    {
      "id": "q2",
      "type": "text",
      "question": "Write >, < or = : 1/3 __ 1/5",
      "answer": ">",
      "solution": "Thirds are larger than fifths of the same whole."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "Complete 1/2 = ?/6.",
      "answer": 3,
      "solution": "Multiply top and bottom by 3."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "Complete 2/3 = ?/6.",
      "answer": 4,
      "solution": "Multiply top and bottom by 2."
    },
    {
      "id": "q5",
      "type": "text",
      "question": "Write >, < or = : 2/4 __ 1/2",
      "answer": "=",
      "solution": "Both represent half."
    }
  ],
  "summary": "Equivalent fractions name the same part of a whole. For fractions with the same denominator, the larger numerator gives the larger fraction. For positive unit fractions of the same whole, a larger denominator gives a smaller part.",
