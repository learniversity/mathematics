  "formulas": [
    {
      "expression": "1,000 = 10 × 100",
      "description": "Ten hundreds make one thousand."
    }
  ],
  "examples": [
    {
      "question": "Write 508 in words.",
      "steps": [
        "Read the hundreds first: five hundred.",
        "There are no tens and there are eight ones."
      ],
      "answer": "five hundred and eight"
    },
    {
      "question": "What number comes immediately before 1,000?",
      "steps": [
        "Subtract one."
      ],
      "answer": "999"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "Write six hundred and twenty in digits.",
      "answer": 620,
      "solution": "600 + 20 = 620."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "Write three hundred and nine in digits.",
      "answer": 309,
      "solution": "300 + 9 = 309."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "What comes after 799?",
      "answer": 800,
      "solution": "799 + 1 = 800."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "What comes before 500?",
      "answer": 499,
      "solution": "500 − 1 = 499."
    },
    {
      "id": "q5",
      "type": "text",
      "question": "Write 215 in words.",
      "answer": "two hundred and fifteen",
      "solution": "215 is two hundred and fifteen."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "How many hundreds make 1,000?",
      "answer": 10,
      "solution": "10 × 100 = 1,000."
