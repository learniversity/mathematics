  "formulas": [
    {
      "expression": "1 hour = 60 minutes",
      "description": "Time conversion."
    },
    {
      "expression": "1/4 hour = 15 minutes",
      "description": "Quarter of an hour."
    }
  ],
  "examples": [
    {
      "question": "Read a clock with the minute hand at 6 and the hour hand halfway between 2 and 3.",
      "steps": [
        "6 × 5 = 30 minutes.",
        "The hour is still 2."
      ],
      "answer": "2:30"
    },
    {
      "question": "How many minutes are in 1 hour and 15 minutes?",
      "steps": [
        "60 + 15 = 75."
      ],
      "answer": "75"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "How many minutes are in half an hour?",
      "answer": 30,
      "solution": "60 ÷ 2 = 30."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "Minute hand points to 3. How many minutes past the hour?",
      "answer": 15,
      "solution": "3 × 5 = 15."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "How many minutes are in 2 hours?",
      "answer": 120,
      "solution": "2 × 60 = 120."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "A lesson starts at 9:00 and ends at 9:45. Duration in minutes?",
      "answer": 45,
      "solution": "45 − 0 = 45."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "How many minutes are in one hour and 20 minutes?",
      "answer": 80,
      "solution": "60 + 20 = 80."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "How many minutes are in a quarter of an hour?",
      "answer": 15,
      "solution": "60 ÷ 4 = 15."
    }
  ],
  "summary": "An analogue clock has 12 numbered hour positions. Each interval between numbers represents five minutes. The minute hand makes one full turn in 60 minutes; the hour hand moves gradually between hours.",
