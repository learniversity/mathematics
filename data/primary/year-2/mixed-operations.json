      "question": "Calculate 320 + 75 − 148.",
      "steps": [
        "320 + 75 = 395.",
        "395 − 148 = 247."
      ],
      "answer": "247"
    },
    {
      "question": "Calculate 400 − (120 + 80).",
      "steps": [
        "120 + 80 = 200.",
        "400 − 200 = 200."
      ],
      "answer": "200"
