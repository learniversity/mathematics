  "formulas": [],
  "examples": [
    {
      "question": "Find the lines of symmetry of a square.",
      "steps": [
        "The horizontal and vertical centre lines match.",
        "Both diagonals also match."
      ],
      "answer": "4"
    },
    {
      "question": "Find the lines of symmetry of a non-square rectangle.",
      "steps": [
        "The horizontal and vertical centre lines match.",
        "Its diagonals do not."
      ],
      "answer": "2"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "How many lines of symmetry has a square?",
      "answer": 4,
      "solution": "Two centre lines and two diagonals."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "How many lines of symmetry has a non-square rectangle?",
      "answer": 2,
      "solution": "Horizontal and vertical."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "How many lines of symmetry has an equilateral triangle?",
      "answer": 3,
      "solution": "One from each vertex to the midpoint opposite."
    },
    {
      "id": "q4",
      "type": "text",
      "question": "Does a typical scalene triangle have line symmetry? Write yes or no.",
      "answer": "no",
      "solution": "Its sides are unequal."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "How many halves are formed by a line of symmetry?",
      "answer": 2,
      "solution": "The two halves match."
    }
  ],
  "summary": "A shape has line symmetry when it can be folded along a line so that the two halves match exactly. The fold line is called a line of symmetry.",
