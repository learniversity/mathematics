  "formulas": [
    {
      "expression": "a/b of N = (N ÷ b) × a",
      "description": "For b nonzero; here groups divide exactly."
    }
  ],
  "examples": [
    {
      "question": "Find one third of 12 apples.",
      "steps": [
        "Divide 12 into 3 equal groups.",
        "12 ÷ 3 = 4."
      ],
      "answer": "4"
    },
    {
      "question": "Find three quarters of 20.",
      "steps": [
        "20 ÷ 4 = 5.",
        "5 × 3 = 15."
      ],
      "answer": "15"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "What is the numerator of 3/5?",
      "answer": 3,
      "solution": "The numerator is the top number."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "What is the denominator of 2/7?",
      "answer": 7,
      "solution": "The denominator is the bottom number."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "Find one half of 18.",
      "answer": 9,
      "solution": "18 ÷ 2 = 9."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "Find one quarter of 16.",
      "answer": 4,
      "solution": "16 ÷ 4 = 4."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "Find two thirds of 12.",
      "answer": 8,
      "solution": "12 ÷ 3 × 2 = 8."
    },
    {
      "id": "q6",
      "type": "text",
      "question": "Write the fraction for 3 of 8 equal parts.",
      "answer": "3/8",
      "solution": "Three selected parts out of eight."
    }
  ],
  "summary": "The denominator is the number of equal parts; the numerator counts the selected parts. To find a unit fraction of a group, divide its size by the denominator. To find several such parts, multiply by the numerator.",
