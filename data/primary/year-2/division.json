  "formulas": [
    {
      "expression": "a ÷ b = c",
      "description": "Then b × c = a, where b is nonzero."
    }
  ],
  "examples": [
    {
      "question": "Share 42 pencils equally among 6 children.",
      "steps": [
        "Find the number that multiplied by 6 gives 42.",
        "6 × 7 = 42."
      ],
      "answer": "7"
    },
    {
      "question": "Make groups of 8 from 32 counters.",
      "steps": [
        "32 ÷ 8 = 4."
      ],
      "answer": "4"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "18 ÷ 2",
      "answer": 9,
      "solution": "2 × 9 = 18, so 18 ÷ 2 = 9."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "27 ÷ 3",
      "answer": 9,
      "solution": "3 × 9 = 27, so 27 ÷ 3 = 9."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "40 ÷ 5",
      "answer": 8,
      "solution": "5 × 8 = 40, so 40 ÷ 5 = 8."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "56 ÷ 7",
      "answer": 8,
      "solution": "7 × 8 = 56, so 56 ÷ 7 = 8."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "72 ÷ 9",
      "answer": 8,
      "solution": "9 × 8 = 72, so 72 ÷ 9 = 8."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "0 ÷ 6",
      "answer": 0,
      "solution": "Sharing zero objects among six groups gives zero in each: 0 ÷ 6 = 0."
    }
  ],
