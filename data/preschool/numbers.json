  "rules": [
    "Point to each dot once as you count.",
    "Say the number name and match it to the numeral.",
    "Two rows of five make ten."
  ],
  "examples": [
    {
      "question": "Write zero using digits.",
      "steps": [
        "Find the matching number card."
      ],
      "answer": "0"
    },
    {
      "question": "Write 10 in words.",
      "steps": [
        "Read the number name beneath the dots."
      ],
      "answer": "ten"
    },
    {
      "question": "How many dots are in 1 full groups of ten?",
      "steps": [
        "Count ten for each full group."
      ],
      "answer": "10"
    }
  ],
