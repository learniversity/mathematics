  "rules": [
    "Point to each dot once as you count.",
    "Say the number name and match it to the numeral.",
    "Count each complete group as ten, then count any remaining dots."
  ],
  "examples": [
    {
      "question": "Write eleven using digits.",
      "steps": [
        "Find the matching number card."
      ],
      "answer": "11"
    },
    {
      "question": "Write 20 in words.",
      "steps": [
        "Read the number name beneath the dots."
      ],
      "answer": "twenty"
    },
    {
      "question": "How many dots are in 2 full groups of ten?",
      "steps": [
        "Count ten for each full group."
      ],
      "answer": "20"
    }
  ],
