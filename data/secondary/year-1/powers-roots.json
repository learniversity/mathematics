  "formulas": [
    {
      "expression": "√(a²) = |a|",
      "description": "Principal square root."
    },
    {
      "expression": "∛(a³) = a",
      "description": "Real cube root."
    }
  ],
  "examples": [
    {
      "question": "Find √196.",
      "steps": [
        "14 × 14 = 196."
      ],
      "answer": "14"
    },
    {
      "question": "Find ∛216.",
      "steps": [
        "6 × 6 × 6 = 216."
      ],
      "answer": "6"
    }
  ],
