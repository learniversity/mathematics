  "formulas": [
    {
      "expression": "HCF(a,b) × LCM(a,b) = a × b",
      "description": "For positive integers a and b."
    }
  ],
  "examples": [
    {
      "question": "Find HCF of 18 and 24.",
      "steps": [
        "Factors common to both: 1, 2, 3, 6."
      ],
      "answer": "6"
    },
    {
      "question": "Find LCM of 8 and 12.",
      "steps": [
        "Multiples of 8: 8, 16, 24; multiples of 12: 12, 24."
      ],
      "answer": "24"
    }
  ],
  "exercises": [
