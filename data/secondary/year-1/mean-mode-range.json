  "formulas": [
    {
      "expression": "Mean = sum ÷ count",
      "description": "For a nonempty set of observations."
    },
    {
      "expression": "Range = maximum − minimum",
      "description": "Spread of observations."
    }
  ],
  "examples": [
    {
      "question": "Find mean of 4, 6, 8 and 10.",
      "steps": [
        "Sum = 28; count = 4.",
        "28 ÷ 4."
      ],
      "answer": "7"
    },
    {
      "question": "Find mode and range of 3, 5, 5, 7, 10.",
      "steps": [
        "5 occurs most often.",
        "Range = 10 − 3."
      ],
      "answer": "Mode 5; range 7"
    }
  ],
