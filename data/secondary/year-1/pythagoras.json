    {
      "question": "Find the hypotenuse when the legs are 6 cm and 8 cm.",
      "steps": [
        "c²=36+64=100; take the positive square root."
      ],
      "answer": "10 cm"
    },
    {
      "question": "Find a missing leg when hypotenuse is 13 cm and other leg is 5 cm.",
      "steps": [
        "13²−5²=144; square root=12."
      ],
      "answer": "12 cm"
    }
