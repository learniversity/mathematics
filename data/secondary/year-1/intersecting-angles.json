  "formulas": [
    {
      "expression": "Interior angle sum = (n − 2) × 180°",
      "description": "Simple polygon with n ≥ 3."
    },
    {
      "expression": "Regular polygon interior angle = (n − 2) × 180°/n",
      "description": "Equal interior angles."
    }
  ],
  "examples": [
    {
      "question": "Two lines intersect; one angle is 67°.",
      "steps": [
        "Its opposite angle equals 67°; an adjacent angle is 180 − 67."
      ],
      "answer": "67° opposite; 113° adjacent"
    },
    {
      "question": "Find the interior angle sum of a pentagon.",
      "steps": [
        "(5 − 2) × 180."
      ],
      "answer": "540°"
    }
  ],
