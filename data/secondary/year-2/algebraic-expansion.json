  "examples": [
    {
      "question": "Simplify 5x + 3 − 2x + 7.",
      "steps": [
        "Combine x terms: 5x − 2x = 3x; constants: 3 + 7."
      ],
      "answer": "3x + 10"
    },
    {
      "question": "Expand 4(2x − 3).",
      "steps": [
        "4×2x = 8x; 4×(−3) = −12."
      ],
      "answer": "8x − 12"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "Coefficient of x after simplifying 7x − 3x?",
      "answer": 4,
      "solution": "7 − 3."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "Constant after simplifying 3x + 8 − x − 5?",
      "answer": 3,
      "solution": "8 − 5."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "Coefficient of x in 5(2x + 1)?",
      "answer": 10,
      "solution": "5 × 2."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "Constant in expanded 3(x − 4)?",
      "answer": -12,
      "solution": "3 × −4."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "Evaluate 2(3x + 1) at x=4.",
      "answer": 26,
      "solution": "2 × 13."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "Evaluate x² − 2x at x=5.",
      "answer": 15,
      "solution": "25 − 10."
