  "level": "secondary-2",
  "category": "Algebra",
  "introduction": "Develop mathematical understanding through arithmetic and geometric sequences.",
  "definition": "An arithmetic sequence adds a constant difference to obtain each next term. A geometric sequence multiplies by a constant ratio. The nth-term rule uses the first term and n−1 steps.",
  "visuals": [],
  "formulas": [
    {
      "expression": "aₙ = a₁ + (n−1)d",
      "description": "Arithmetic sequence."
    },
    {
      "expression": "aₙ = a₁rⁿ⁻¹",
      "description": "Geometric sequence; nth term for n≥1, with first term specified separately if r=0."
    }
  ],
  "examples": [
    {
      "question": "Find the 12th term of 4, 9, 14, ...",
      "steps": [
        "First term 4, difference 5; 4+11×5."
      ],
      "answer": "59"
    },
    {
      "question": "Find the 6th term of 3, 6, 12, ...",
      "steps": [
        "First term 3, ratio 2; 3×2⁵."
      ],
      "answer": "96"
    }
  ],
