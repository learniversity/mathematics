  "examples": [
    {
      "question": "Locate (−3,2).",
      "steps": [
        "Move three units left and two up."
      ],
      "answer": "Quadrant II"
    },
    {
      "question": "A point (2,−4) moves five units up.",
      "steps": [
        "x remains 2; y = −4 + 5."
      ],
      "answer": "(2,1)"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "x-coordinate of (−5,3)?",
      "answer": -5,
      "solution": "First coordinate."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "y-coordinate of (4,−7)?",
      "answer": -7,
      "solution": "Second coordinate."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "Quadrant of (−2,−3)? Enter 1, 2, 3 or 4.",
      "answer": 3,
      "solution": "Both coordinates negative."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "Point (−3,5) moves 6 right. New x?",
      "answer": 3,
      "solution": "−3 + 6."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "Point (2,−1) moves 4 down. New y?",
      "answer": -5,
      "solution": "−1 − 4."
    },
    {
      "id": "q6",
      "type": "numeric",
      "question": "Distance along x-axis from (−2,0) to (5,0)?",
      "answer": 7,
      "solution": "5 − (−2)."
    }
  ],
  "summary": "The Cartesian plane has perpendicular x and y axes crossing at the origin. A point (x,y) gives the horizontal and vertical coordinates. Positive x moves right, negative x left; positive y moves up, negative y down. Quadrants I, II, III and IV are numbered anticlockwise starting at the upper right.",
