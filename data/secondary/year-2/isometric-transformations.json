  "formulas": [
    {
      "expression": "Reflection in x-axis: (x,y) → (x,−y)",
      "description": "Coordinate rule."
    },
    {
      "expression": "Reflection in y-axis: (x,y) → (−x,y)",
      "description": "Coordinate rule."
    },
    {
      "expression": "Translation: (x,y) → (x+a,y+b)",
      "description": "Displacement (a,b)."
    }
  ],
  "examples": [
    {
      "question": "Reflect (3,−2) in the y-axis.",
      "steps": [
        "Reverse the sign of x; keep y."
      ],
      "answer": "(−3,−2)"
    },
    {
      "question": "Translate (−1,4) by 3 right and 2 down.",
      "steps": [
        "x = −1 + 3; y = 4 − 2."
      ],
      "answer": "(2,2)"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "numeric",
      "question": "Reflect (4,2) in y-axis. New x?",
      "answer": -4,
      "solution": "Reverse x."
    },
    {
      "id": "q2",
      "type": "numeric",
      "question": "Reflect (−3,5) in x-axis. New y?",
      "answer": -5,
      "solution": "Reverse y."
    },
    {
      "id": "q3",
      "type": "numeric",
      "question": "Translate (2,3) by 5 right. New x?",
      "answer": 7,
      "solution": "2 + 5."
    },
    {
      "id": "q4",
      "type": "numeric",
      "question": "Translate (4,−1) by 3 down. New y?",
      "answer": -4,
      "solution": "−1 − 3."
    },
    {
      "id": "q5",
      "type": "numeric",
      "question": "A half-turn is how many degrees?",
      "answer": 180,
      "solution": "Half of 360°."
    },
    {
      "id": "q6",
      "type": "text",
      "question": "Does translation change side lengths? yes/no",
      "answer": "no",
      "solution": "Translations preserve distances."
    }
  ],
  "summary": "A translation moves every point by the same displacement. A reflection flips a shape across a mirror line. A rotation turns a shape about a fixed centre through an angle. These transformations preserve lengths and angles.",
